global
    log /dev/log local0
    log /dev/log local1 notice
    user haproxy
    group haproxy
    daemon

# Default settings
defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout client  30s
    timeout server  30s
    timeout connect 5s

# Frontend configuration
frontend http_front
    bind *:80
    # Redirect all HTTP traffic to HTTPS
    http redirect scheme https code 301 if !{ ssl_fc }

# Backend configuration
backend https_back
    # Specify your backend servers here
    47538-web-01 34.229.67.93:443 ssl check
    47538-web-02 52.86.25.39:443 ssl check
