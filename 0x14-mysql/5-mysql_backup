#!/bin/bash

# Check if a password argument is provided
if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <mysql_password>"
    exit 1
fi

# Get the password from the argument
MYSQL_PASSWORD=$1

# Define the backup file names
DUMP_FILE="backup.sql"
DATE=$(date +%d-%m-%Y)
ARCHIVE_FILE="${DATE}.tar.gz"

# Generate MySQL dump
mysqldump -u root -p"$MYSQL_PASSWORD" --all-databases > "$DUMP_FILE"

# Check if the dump was successful
if [ $? -ne 0 ]; then
    echo "MySQL dump failed!"
    exit 1
fi

# Create a compressed tar.gz archive
tar -czf "$ARCHIVE_FILE" "$DUMP_FILE"

# Check if the archive was created successfully
if [ $? -ne 0 ]; then
    echo "Failed to create archive!"
    exit 1
fi

# Optionally remove the dump file after archiving
rm "$DUMP_FILE"

echo "Backup completed: $ARCHIVE_FILE"
